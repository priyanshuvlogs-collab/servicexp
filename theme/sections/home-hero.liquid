{% include 'brand' %}
<section class="hero">
  <div class="wrap">
    <p class="kicker">Markham team · GTA trucks</p>
    <h1>No heat, no cooling, or a condo unit down — call dispatch.</h1>
    <p class="lede">Service Express is a Markham HVAC shop for houses, high-rise fan coils and heat pumps, and commercial rooftops. Not a slogan mill. Call (416) 637-1678 or send the address.</p>
    <div class="hero__actions">
      <a class="btn-call btn-call--xl" href="{{ sx_tel }}" style="width:auto;min-width:16rem;">Call {{ sx_phone }}</a>
      <a class="btn-outline" href="/pages/contact-residential-commercial-hvac-company-gta#job-request">Request a tech</a>
    </div>
    <ul class="chips">
      <li>{{ settings.google_rating | default: '4.8' }} Google</li>
      <li>15,000+ customers claimed on this site</li>
      <li>24/7 emergency dispatch</li>
    </ul>
  </div>
</section>
{% schema %}{ "name": "Home hero", "settings": [] }{% endschema %}
