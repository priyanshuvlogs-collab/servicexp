{% include 'brand' %}
<section class="page-hero">
  <div class="wrap">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="lede">{{ section.settings.lede }}</p>
    <div class="hero__actions">
      <a class="btn-call" href="{{ sx_tel }}">Call {{ sx_phone }}</a>
      <a class="btn-outline" href="{{ section.settings.form_url | default: '/pages/contact-residential-commercial-hvac-company-gta#job-request' }}">{{ section.settings.cta_label | default: 'Price this job' }}</a>
    </div>
  </div>
</section>
<section>
  <div class="wrap prose">
    {{ section.settings.body }}
    {% if page.content != blank %}{{ page.content }}{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Page prose",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "H1" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "form_url", "label": "Form URL", "default": "/pages/contact-residential-commercial-hvac-company-gta#job-request" },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "Request a tech" }
  ]
}
{% endschema %}
